<% /* Developed by Hirnyk Vlad (HERN1k) */ %>
<% /** @layout props: IPageProps */ %>

<%~ it.header %>

<div class="flex items-center justify-center min-h-[70vh] text-center px-5 animate-[fade-up_0.6s_ease-out]">
    <div class="relative max-w-[500px]">
        <h1 class="text-[120px] font-black leading-none text-white mb-8 opacity-20">404</h1>
        
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -mt-10 text-[#a29bfe] animate-bounce">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M16 16s-1.5-2-4-2-4 2-4 2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
        </div>

        <h2 class="text-3xl font-bold text-white mb-4">Page not found</h2>
        <p class="text-[#94a3b8] leading-relaxed mb-8">
            Unfortunately, nothing was found at the requested address.<br>
            The page may have been deleted or moved.
        </p>
        
        <div class="flex gap-4 justify-center">
            <a href="/" class="px-6 py-3 rounded-full bg-[#6c5ce7] text-white font-semibold shadow-[0_4px_15px_rgba(108,92,231,0.3)] transition-transform hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(108,92,231,0.4)]">
                Return to home page
            </a>
            <button onclick="history.back()" class="px-6 py-3 rounded-full bg-[#f8f9fa] text-[#1c1f2b] font-semibold border border-gray-200 transition-transform hover:-translate-y-0.5">
                Back
            </button>
        </div>
    </div>
</div>

<%~ it.footer %>